# ATENCAO: credenciais administrativas NAO ficam em .env / .env.local (o Next as carrega no
# processo da aplicacao). Guarde-as em .env.admin (ignorado pelo git; nunca carregado pelo Next)
# e use-as apenas via `node --env-file=.env.admin ...` em scripts de inventario/migration.
# Conexao somente-leitura para inventario/consultas (nunca use para migrations).
DATABASE_URL=
PGSSLMODE=

# Alvo EXPLICITO das migrations acc_* (banco local/homologacao por padrao).
# Producao exige --confirm-host=<host>. Nunca aponte para producao sem aprovacao.
ACC_MIGRATE_URL=

# Conexao limitada da aplicacao (role sem superusuario). Criada em etapa propria.
ACC_APP_DATABASE_URL=
SESSION_SECRET=
