{
  "name": "vne-agent-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:preview": "node scripts/migrate.mjs preview",
    "db:migrate:apply": "node scripts/migrate.mjs apply",
    "db:migrate:verify": "node scripts/migrate.mjs verify",
    "db:migrate:down": "node scripts/migrate.mjs down",
    "test:migration:db": "node scripts/test-migration.mjs",
    "db:app-role:preview": "node scripts/setup-app-role.mjs preview",
    "db:app-role:apply": "node scripts/setup-app-role.mjs apply",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:all": "npm run typecheck && npm test && npm run test:db && npm run test:migration:db && npm run build && npm run test:smoke",
    "db:admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "test:smoke": "node scripts/smoke-app.mjs",
    "db:registry:preview": "node --env-file=.env.local scripts/seed-registry.mjs preview",
    "db:registry:apply": "node --env-file=.env.local scripts/seed-registry.mjs apply"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.3.6",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
